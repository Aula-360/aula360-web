---
import { waLink, waMessages } from "../../data/site";
---

<section>
  <div class="container">
    <div class="featured-class">
      <div class="featured-class-content">
        <p class="section-label">Próxima clase en vivo</p>
        <h2>
          Clase Magistral en Rehabilitación Estructural Hospitalaria
        </h2>
        <div class="featured-meta">
          <span class="meta-tag">10 oct</span>
          <span class="meta-tag">7:00 pm</span>
          <span class="meta-tag">Virtual en vivo</span>
          <span class="meta-tag meta-price">S/ 18</span>
        </div>
        <div class="featured-actions">
          <a href={waLink(waMessages.masterclassInscripcion)} class="btn btn-wa">
            Inscribirme por WhatsApp
          </a>
          <a href="/clase-magistral.html" class="featured-link">
            Ver detalles →
          </a>
        </div>
      </div>
      <div class="featured-class-image">
        <img
          src="/images/Move_column_right_remove_noise_202609071200.webp"
          alt="Clase magistral de rehabilitación estructural hospitalaria"
        />
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 0 0 80px;
  }
  .featured-class {
    display: flex;
    flex-direction: column;
    gap: 32px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 32px;
  }
  @media (min-width: 768px) {
    .featured-class {
      flex-direction: row;
      align-items: center;
    }
  }
  .featured-class-content {
    flex: 1;
    min-width: 0;
  }
  .featured-class-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 16px;
  }
  @media (min-width: 768px) {
    .featured-class-content h2 {
      font-size: 1.75rem;
    }
  }
  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .meta-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: rgba(10, 37, 64, 0.06);
    color: var(--color-text-secondary);
  }
  .meta-price {
    background: var(--color-whatsapp);
    color: #fff;
  }
  .featured-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .featured-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .featured-link:hover {
    text-decoration: underline;
  }
  .featured-class-image {
    flex: 0 0 280px;
    min-width: 0;
  }
  .featured-class-image img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
</style>
