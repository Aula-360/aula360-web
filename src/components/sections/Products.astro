---
import { products, waLink } from "../../data/site";
---

<section id="catalogo">
  <div class="container">
    <div class="products-header">
      <p class="section-label">Catálogo</p>
      <h2 class="section-title">Elige tu expediente</h2>
      <p class="section-sub">
        Todos a S/ 18. Todos con entrega inmediata por WhatsApp.
      </p>
    </div>
    <div class="products-grid">
      {
        products.map((product) => (
          <article class="product-card">
            <div class="product-img">
              <img src={product.image} alt={product.name} />
            </div>
            <div class="product-body">
              <h3>
                {product.icon} {product.name}
              </h3>
              <p>{product.description}</p>
              <div class="product-footer">
                <span class="product-price">{product.price}</span>
                <a
                  href={waLink(product.whatsappMessage)}
                  class="btn btn-wa"
                  style="padding: 8px 18px; font-size: 0.875rem"
                >
                  Comprar
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 0 0 80px;
  }
  .products-header {
    margin-bottom: 40px;
  }
  .products-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .product-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .product-card:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }
  .product-img {
    width: 100%;
    aspect-ratio: 16 / 10;
  }
  .product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .product-body {
    padding: 20px 24px 24px;
  }
  .product-body h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .product-body p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 16px;
  }
  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
</style>
