---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Retirar Contenido — Aula 360">
  <Header />
  <main>
    <div class="container">
      <h1>Retirar Contenido de Expedientes Técnicos</h1>
      <p class="updated">Solicitud de retiro de archivos de infoproductos</p>

      <p>
        Si deseas que retiremos algún archivo de contenido de los infoproductos
        adquiridos, completa el siguiente formulario. Revisaremos tu solicitud y
        nos comunicaremos contigo por correo o WhatsApp.
      </p>

      <form
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        onsubmit="handleSubmit(event)"
      >
        <input
          type="hidden"
          name="access_key"
          value="0cfcb793-e1e2-44a4-aaea-1705bb966cec"
        />
        <input
          type="hidden"
          name="subject"
          value="retirar contenido de expedientes tecnicos"
        />
        <input
          type="hidden"
          name="from_name"
          value="Retiro de Contenido - Aula 360"
        />
        <input type="hidden" name="replyto" id="replyto" value="" />

        <div class="form-group">
          <label for="name">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Tu nombre completo"
          />
        </div>

        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@correo.com"
          />
        </div>

        <div class="form-group">
          <label for="whatsapp">Número de WhatsApp</label>
          <input
            type="tel"
            id="whatsapp"
            name="whatsapp"
            required
            placeholder="+51 999 999 999"
          />
        </div>

        <div class="form-group">
          <label for="archivo">Archivo que deseas retirar</label>
          <input
            type="text"
            id="archivo"
            name="archivo"
            required
            placeholder="Nombre o identificación del archivo"
          />
        </div>

        <div class="form-group">
          <label for="motivo">Motivo de la solicitud</label>
          <textarea
            id="motivo"
            name="motivo"
            required
            placeholder="Explica brevemente por qué solicitas el retiro del archivo..."
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary"
          >Enviar Solicitud</button
        >
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding: 64px 0 80px;
  }
  .container {
    max-width: 720px;
  }
  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .updated {
    color: var(--color-text-faint);
    font-size: 0.8125rem;
    margin-bottom: 40px;
  }
  p {
    color: #374151;
    margin-bottom: 16px;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 14px;
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--color-text);
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-md);
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(43, 132, 203, 0.12);
  }
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
</style>

<script>
  async function handleSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const original = btn.textContent;
    form.replyto.value = form.email.value;
    btn.textContent = "Enviando...";
    btn.disabled = true;

    try {
      const formData = new FormData(form);
      const resp = await fetch(form.action, {
        method: "POST",
        body: formData,
      });
      const data = await resp.json();

      if (data.success) {
        btn.textContent = "Solicitud Enviada ✓";
        btn.style.background = "#2baa6b";
        form.reset();
      } else {
        btn.textContent = "Error, intenta de nuevo";
        btn.style.background = "#dc2626";
      }
    } catch {
      btn.textContent = "Error de conexión";
      btn.style.background = "#dc2626";
    }

    btn.disabled = false;
    setTimeout(() => {
      btn.textContent = original;
      btn.style.background = "";
    }, 4000);
  }
</script>
